{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate-first classification result",
  "type": "object",
  "required": ["candidate_decision", "confidence"],
  "properties": {
    "primary_category_id": {"type": ["string", "null"], "pattern": "^cat_[a-z0-9_]+$"},
    "secondary_category_ids": {"type": "array", "maxItems": 3,
      "items": {"type": "string", "pattern": "^cat_[a-z0-9_]+$"}},
    "tag_ids": {"type": "array", "maxItems": 8, "items": {"type": "string"}},
    "candidate_decision": {"enum": ["selected", "none_of_the_above", "abstain"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "new_topic_proposal": {
      "type": ["object", "null"],
      "properties": {
        "title": {"type": "string", "maxLength": 80},
        "parent_id": {"type": "string", "pattern": "^cat_[a-z0-9_]+$"},
        "reason": {"type": "string", "maxLength": 300}
      },
      "required": ["title", "parent_id"]
    },
    "reason_short": {"type": "string", "maxLength": 300}
  },
  "additionalProperties": false
}
