{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional model second-opinion on capture quality",
  "type": "object",
  "required": ["verdict", "confidence"],
  "properties": {
    "verdict": {"enum": ["complete", "usable_partial", "metadata_only", "failed", "unsure"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "missing_elements": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 120}},
    "reasons": {"type": "array", "maxItems": 6, "items": {"type": "string", "maxLength": 200}}
  },
  "additionalProperties": false
}
