{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capture record (normalized output of any adapter)",
  "type": "object",
  "required": ["id", "canonical_url_or_local", "platform", "title", "captured_at",
               "capture_status", "capture_method", "content_hash", "state"],
  "properties": {
    "id": {"type": "string", "pattern": "^src_[0-9a-f]{16}$"},
    "source_url": {"type": ["string", "null"]},
    "canonical_url": {"type": ["string", "null"]},
    "canonical_url_or_local": {"type": "string"},
    "platform": {"type": "string"},
    "title": {"type": "string"},
    "authors": {"type": "array", "items": {"type": "string"}},
    "published_at": {"type": ["string", "null"]},
    "captured_at": {"type": "string"},
    "lang": {"type": "string"},
    "text": {"type": "string"},
    "ocr_text": {"type": ["string", "null"]},
    "images": {"type": "array", "items": {"type": "string"}},
    "attachments": {"type": "array", "items": {"type": "string"}},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "capture_status": {"enum": ["complete", "usable_partial", "metadata_only", "failed"]},
    "capture_method": {"enum": ["direct", "api", "jina", "browser", "firecrawl", "mediacrawler",
                                 "ocr", "transcript", "whisper", "manual", "none"]},
    "content_completeness": {"type": "number", "minimum": 0, "maximum": 1},
    "needs_retry": {"type": "boolean"},
    "missing_elements": {"type": "array", "items": {"type": "string"}},
    "quality_reasons": {"type": "array", "items": {"type": "string"}},
    "state": {"enum": ["received", "capturing", "normalized", "quality_checked",
                        "usable", "retry_required", "metadata_only", "failed",
                        "enriched", "classified", "staged", "validated",
                        "committed", "indexed", "reported"]},
    "via": {"type": ["string", "null"]},
    "run_id": {"type": "string"}
  }
}
